{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../scripts/run.mjs --watch",
    "start": "node ../scripts/run.mjs",
    "dev:gateway": "node --watch src/index.js",
    "dev:story": "node --watch src/run-service.js story",
    "dev:gameplay": "node --watch src/run-service.js gameplay",
    "dev:discovery": "node --watch src/run-service.js discovery",
    "dev:audit": "node --watch src/run-service.js audit",
    "start:gateway": "node src/index.js",
    "start:story": "node src/run-service.js story",
    "start:gameplay": "node src/run-service.js gameplay",
    "start:discovery": "node src/run-service.js discovery",
    "start:audit": "node src/run-service.js audit",
    "db:init": "node src/db/init.js",
    "db:seed": "node src/db/init.js --seed",
    "db:local": "node scripts/db-local.mjs",
    "dev:session": "node scripts/dev-session.mjs",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^4.21.0",
    "google-auth-library": "^11.3.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^6.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.4.3"
  }
}
