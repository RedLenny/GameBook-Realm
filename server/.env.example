PORT=3001
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173
SERVICE_HOST=127.0.0.1
STORY_PORT=3002
GAMEPLAY_PORT=3003
DISCOVERY_PORT=3004
AUDIT_PORT=3005
# Optional overrides when services run on other hosts; otherwise derived from ports.
# STORY_SERVICE_URL=http://127.0.0.1:3002
# GAMEPLAY_SERVICE_URL=http://127.0.0.1:3003
# DISCOVERY_SERVICE_URL=http://127.0.0.1:3004
# AUDIT_SERVICE_URL=http://127.0.0.1:3005
SERVICE_TIMEOUT_MS=3000
# Shared credential for individually launched services. The stack launcher generates one if empty.
INTERNAL_SERVICE_TOKEN=
# MongoDB (lokálně nebo MongoDB Atlas). Každá služba má vlastní databázi <prefix>_<služba>.
MONGODB_URI=mongodb://127.0.0.1:27017
# For the shared Atlas cluster, set MONGODB_URI in server/.env or in the environment.
# Replace both placeholders with the URL-encoded credentials of your application's database user.
# MONGODB_URI=mongodb+srv://<db-user>:<db-password>@cluster0.y5mdx8e.mongodb.net/
MONGODB_DB_PREFIX=gamebook

# Google login (task "Google Cloud OAuth client configuration"). Without these /api/auth answers 503.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
FRONTEND_URL=http://localhost:5173
# Random string, at least 32 characters. Never commit the real value.
SESSION_SECRET=
