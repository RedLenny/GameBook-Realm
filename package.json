{
  "name": "gamebook-realm",
  "private": true,
  "scripts": {
    "install:all": "cd server && npm install && cd ../client && npm install",
    "ci": "npm --prefix server ci && npm --prefix client ci",
    "dev": "node scripts/run.mjs --watch --client",
    "start": "node scripts/run.mjs",
    "dev:server": "npm --prefix server run dev",
    "dev:gateway": "npm --prefix server run dev:gateway",
    "dev:story": "npm --prefix server run dev:story",
    "dev:gameplay": "npm --prefix server run dev:gameplay",
    "dev:discovery": "npm --prefix server run dev:discovery",
    "dev:audit": "npm --prefix server run dev:audit",
    "dev:client": "npm --prefix client run dev",
    "dev:client:mock": "npm --prefix client run dev:mock",
    "db:init": "npm --prefix server run db:init",
    "db:seed": "npm --prefix server run db:seed",
    "db:up": "docker compose up -d --wait mongo",
    "db:down": "docker compose down",
    "db:local": "npm --prefix server run db:local",
    "dev:session": "npm --prefix server run dev:session --",
    "build": "npm --prefix client run build",
    "test": "npm --prefix server test && npm --prefix client test",
    "check": "npm test && npm run build"
  }
}
